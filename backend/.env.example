# =============================================================================
# Backend environment variables — copy to .env.local and fill in real values.
# =============================================================================

# -----------------------------------------------------------------------------
# LiveKit (real-time transport)
# Get these from https://cloud.livekit.io/ → your project → Settings
# -----------------------------------------------------------------------------
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key_here
LIVEKIT_API_SECRET=your_livekit_api_secret_here

# -----------------------------------------------------------------------------
# Murf (TTS — Text-to-Speech)
# Get your API key from https://murf.ai/api/dashboard
# -----------------------------------------------------------------------------
MURF_API_KEY=your_murf_api_key_here

# -----------------------------------------------------------------------------
# Deepgram (STT — Speech-to-Text)
# Get your API key from https://deepgram.com
# -----------------------------------------------------------------------------
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# -----------------------------------------------------------------------------
# LLM — use one of the following depending on which provider you use
# -----------------------------------------------------------------------------
# For Gemini (default): get from https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_google_api_key_here

# For OpenAI: get from https://platform.openai.com/api-keys (if using OpenAI LLM)
# OPENAI_API_KEY=your_openai_api_key_here

# -----------------------------------------------------------------------------
# Day 6 — Outbound calling (LiveKit SIP outbound trunk)
# Create the outbound trunk in the LiveKit Cloud console (Telephony → SIP
# trunks → Outbound) and paste its ID here. Never hardcode this in source.
# -----------------------------------------------------------------------------
LIVEKIT_SIP_OUTBOUND_TRUNK_ID=ST_your_outbound_trunk_id_here

# The SIP destination passed to LiveKit is the bare username / phone number
# (sip_call_to accepts a SIP user, not a full URI). The SIP domain is configured
# on the outbound trunk itself — no domain env var is needed.

# -----------------------------------------------------------------------------
# PostgreSQL (persistent caller memory — Day 4)
# The SAME instance must be reachable from the backend. Format:
#   postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Example for a local instance on port 5433:
#   postgresql://postgres:your_password@127.0.0.1:5433/postgres
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:your_password@127.0.0.1:5433/postgres

